[gd_scene load_steps=2 format=3]

; perk_choice.tscn — оверлей выбора временного перка (M6.1b; GDD «Временные перки»).
; Полноэкранный затемнённый слой поверх мира: заголовок «Выбери перк», подсказка «игра на
; паузе» и HBox из двух карточек (строятся кодом в perk_choice.gd: название, категория,
; описание, кнопка «Взять»). Корень и Dim прозрачны для тапов (mouse_filter = 2), карточки
; и кнопки — STOP. process_mode = 3 (ALWAYS): выбор работает при get_tree().paused = true.

